name: sh

extensions:
sh
bash
zsh
bashrc
zshrc
bash_profile
bash_aliases
profile

keywords:
if
then
else
elif
fi
case
esac
for
while
until
do
done
in
select
function
time
coproc
return
break
continue
exit
local
export
readonly
declare
typeset
true
false
set
unset
shift
eval
exec
source
trap
wait
test
let
command
builtin
read
printf
echo
cd
pwd
pushd
popd
alias
unalias
shopt
getopts
type
hash
jobs
fg
bg
kill
disown
ulimit
umask
mapfile
readarray
complete
compgen
compopt
bind
caller
enable
help
history
logout
suspend
dirs

ops:
<<<
<<-
;;&
<<
>>
&&
||
|&
;&
;;
=~
==
!=
+=
-=
*=
/=
%=
<=
>=
[[
]]
$(
${
&>
>&
>|
-eq
-ne
-lt
-le
-gt
-ge
-nt
-ot
-ef

comments:
#

directive: $
